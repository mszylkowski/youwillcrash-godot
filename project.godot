; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="You Will Crash"
config/version="0.1.6"
run/main_scene="uid://b5pbc84g5mdio"
config/custom_user_dir_name="Montevisoft/YouWillCrash"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0, 0.4, 0.501961, 1)
boot_splash/fullsize=false
boot_splash/image="uid://bqynfnsns4wkq"
config/icon="uid://bqynfnsns4wkq"

[autoload]

GameState="*res://Scripts/Globals/GameStateGlobal.gd"
Events="*res://Scripts/Globals/EventsGlobal.gd"
Audios="*res://Scripts/Globals/AudioGlobal.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[global_group]

currency="Object is currency pickup"

[gui]

theme/custom="uid://cj5jgds7mrx8"
theme/custom_font="uid://dfdypnhu1aww5"
theme/default_font_antialiasing=2

[layer_names]

2d_render/layer_1="PlayerLight"
2d_physics/layer_1="Player"
2d_physics/layer_2="Obstacles"
2d_physics/layer_3="UI"

[physics]

2d/physics_engine="GodotPhysics2D"
2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.827451, 0.929412, 0.968627, 1)
